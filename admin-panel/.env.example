# Supabase Dashboard -> Project Settings -> API
# NOTE: this is the "anon public" key, NOT the service_role key the
# Python engine uses — the anon key is *meant* to be public/embedded in
# a browser app like this one. What actually protects your data is Row
# Level Security (supabase/migrations/001_admin_panel.sql) plus the
# login screen (Supabase Auth) — see docs/09_ADMIN_PANEL.md.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
