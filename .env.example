# ─────────────────────────────────────────────────────────────────
# .env — copy this file to .env and fill in your real values.
# Never commit .env (it's in .gitignore). Never paste it anywhere,
# including into an AI chat. If a key is ever exposed, rotate it.
#
# Add the SAME values as GitHub repository secrets
# (Settings -> Secrets and variables -> Actions) for the scheduled
# workflows — see docs/05_GITHUB_ACTIONS_SECRETS.md for the exact list.
# ─────────────────────────────────────────────────────────────────

# ── Script generation (Gemini, free tier) ───────────────────────────
# Get from: https://aistudio.google.com/ -> Get API key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional override — leave blank to use the code's current default.
# GEMINI_MODEL=gemini-2.5-flash
# 0.2 = safe/repetitive, 0.9 = default, 1.4 = highly varied but riskier.
GEMINI_TEMPERATURE=0.9

# Optional free backup #1, only used on a genuine daily 429 from Gemini.
# console.groq.com/keys -> sign in -> Create API Key. ~2 minutes, no card.
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Optional free backup #2 (GitHub Models) needs NO secret in Actions —
# just the `models: read` permission already set in generate.yml. Only
# needed here for running the pipeline locally outside Actions.
# GITHUB_MODELS_TOKEN=your_github_pat_with_models_read_scope

# ── Database (Supabase) ─────────────────────────────────────────────
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# SUPABASE_ANON_KEY=  (not used by this project — no admin panel/auth)

# ── Storage (Cloudflare R2 — optional, see docs/02) ─────────────────
# Leave all four blank and the pipeline falls back to Supabase Storage
# (1 GB free vs R2's 10 GB free + zero egress fees).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=
STORAGE_BUCKET=daily-history-shorts

# ── YouTube publishing ───────────────────────────────────────────────
# Run `python -m engine.publisher --setup` once locally (needs a real
# browser) — it opens Google's consent screen and prints these three
# values. See docs/04_YOUTUBE_OAUTH_SETUP.md.
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here
# Shown as an on-screen watermark; no @ needed.
YOUTUBE_CHANNEL_HANDLE=your_channel_handle

# ── Voice pipeline (Section 6: VOICE_PROVIDER = free | cloned | paid) ──
VOICE_PROVIDER=free

# free tier #1 — Google Cloud TTS. console.cloud.google.com -> enable
# "Cloud Text-to-Speech API" -> Credentials -> Create API key.
# GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# free tier #2 — Azure Neural TTS, tried if Google's free tier is spent.
# portal.azure.com -> create a "Speech" resource (free F0 tier).
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=eastus

# cloned tier — self-hosted Coqui XTTS. See docs/06 before using this;
# only clone a voice you own or have explicit consent to use.
# XTTS_SPEAKER_WAV_PATH=assets/voice_samples/my_voice.wav

# paid tier — ElevenLabs, OFF unless VOICE_PROVIDER=paid.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# No PIPER_MODEL_PATH here on purpose — Kokoro (bundled, auto-downloads
# its own model) replaced Piper as this project's offline fallback tier.

# ── Voice/accent overrides — all optional, every one already defaults to
# Indian English (en-IN) in code since this channel is India-first. Only
# uncomment if you want a DIFFERENT voice/accent than the default.
# GOOGLE_TTS_VOICE_NAME=en-IN-Neural2-B
# GOOGLE_TTS_LANGUAGE_CODE=en-IN
# AZURE_TTS_VOICE_NAME=en-IN-PrabhatNeural
# AZURE_TTS_LANGUAGE_CODE=en-IN
# GTTS_TLD=co.in
# Kokoro has no Indian-English voice in its bundled pack (see docs/03) —
# these two are here only in case a future Kokoro release adds one.
# KOKORO_VOICE_ID=bm_george
# KOKORO_VOICE_LANG=en-gb

# ── Optional: AI-generated abstract B-roll (Section 12/15 hook) ────
# Only used for non-person "This Day in History" events with no good
# archival photo. huggingface.co/settings/tokens -> New token -> "Read".
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ── Festival calendar refresh (Section 3) ───────────────────────────
# Free tier: calendarific.com/signup (500 calls/month, no card).
# Leave blank and the Observance category simply has no lunar festivals
# until you add a key or seed the table yourself — see docs/07.
# CALENDARIFIC_API_KEY=

# ── Alerts (optional but strongly recommended — see docs/05) ─────────────
# Every failure in this pipeline is otherwise silent. Telegram and email
# are independent — set up either one, or both. See docs/05 for the
# step-by-step for each (Gmail App Password works for SMTP below).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ── Pipeline settings ────────────────────────────────────────────────
OUTPUT_DIR=output
ASSETS_DIR=assets
# Target spoken runtime per video/part (Section 2: ~45-60s window).
TARGET_RUNTIME_SECONDS=52
# Safety cap derived from YouTube's 10,000-unit/day free quota (Section 8).
MAX_UPLOADS_PER_DAY=6
